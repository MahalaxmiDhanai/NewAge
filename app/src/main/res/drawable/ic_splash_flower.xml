<?xml version="1.0" encoding="utf-8"?>
<!-- Bloom flower logo — matches Figma 512×512 exactly.
     Vertical petals (top/bottom) are taller; horizontal petals (left/right) are wider.
     Petals use ellipse paths with bezier curves for smooth roundness. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top petal — tall vertical oval, centred above midpoint -->
    <path
        android:fillColor="#A8564F"
        android:pathData="
          M54,19
          C58.6,19 62.4,24.3 62.4,30.8
          C62.4,37.3 58.6,42.6 54,42.6
          C49.4,42.6 45.6,37.3 45.6,30.8
          C45.6,24.3 49.4,19 54,19 Z" />

    <!-- Bottom petal — tall vertical oval, centred below midpoint -->
    <path
        android:fillColor="#A8564F"
        android:pathData="
          M54,65.4
          C58.6,65.4 62.4,70.7 62.4,77.2
          C62.4,83.7 58.6,89 54,89
          C49.4,89 45.6,83.7 45.6,77.2
          C45.6,70.7 49.4,65.4 54,65.4 Z" />

    <!-- Left petal — wide horizontal oval -->
    <path
        android:fillColor="#A8564F"
        android:pathData="
          M19,54
          C19,49.4 24.3,45.6 30.8,45.6
          C37.3,45.6 42.6,49.4 42.6,54
          C42.6,58.6 37.3,62.4 30.8,62.4
          C24.3,62.4 19,58.6 19,54 Z" />

    <!-- Right petal — wide horizontal oval -->
    <path
        android:fillColor="#A8564F"
        android:pathData="
          M65.4,54
          C65.4,49.4 70.7,45.6 77.2,45.6
          C83.7,45.6 89,49.4 89,54
          C89,58.6 83.7,62.4 77.2,62.4
          C70.7,62.4 65.4,58.6 65.4,54 Z" />

    <!-- Gold center circle -->
    <path
        android:fillColor="#B8843A"
        android:pathData="M54,46 A8,8,0,1,1,53.999,46 Z" />
</vector>
